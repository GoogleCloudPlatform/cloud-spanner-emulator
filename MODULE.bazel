################################################################################
# C Toolchain                                                                   #
################################################################################

bazel_dep(name = "gcc_toolchain", version = "0.9.0")

register_toolchains("@gcc_toolchain//:all")

################################################################################
# GoogleAPIs                                                                   #
################################################################################

bazel_dep(name = "googleapis", version = "0.0.0-20260223-edfe7983", repo_name = "com_google_googleapis")
bazel_dep(name = "googleapis-cc", version = "1.0.0")
bazel_dep(name = "googleapis-grpc-cc", version = "1.0.0")
