bazel_dep(name = "googleapis-rules-registry", version = "1.0.0")

################################################################################
# Java Libraries                                                                   #
################################################################################

java_toolchains = use_extension("@rules_java//java:extensions.bzl", "toolchains")
use_repo(java_toolchains, "local_jdk")

bazel_dep(name = "rules_jvm_external", version = "6.8")

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
use_repo(maven, "maven")

maven.install(
    artifacts = [
        "com.google.api.grpc:proto-google-common-protos:2.59.2",
        "com.google.code.findbugs:jsr305:3.0.2",
        "com.google.code.gson:gson:2.11.0",
        "com.google.errorprone:error_prone_annotations:2.30.0",
        "com.google.guava:guava:32.1.3-jre",
        "com.google.truth:truth:1.4.2",
        "io.netty:netty-common:4.1.124.Final",
        "io.netty:netty-transport:4.1.124.Final",
        "io.opencensus:opencensus-api:0.31.0",
        "io.opencensus:opencensus-contrib-grpc-metrics:0.31.0",
        "junit:junit:4.13.2",
        "net.java.dev.javacc:javacc:7.0.13",
    ],
    known_contributing_modules = [
        "cloud_spanner_emulator",
        "googlesql",
        "grpc-java",
        "protobuf",
    ],
)

################################################################################
# Golang Libraries                                                             #
################################################################################

bazel_dep(name = "gazelle", version = "0.45.0", repo_name = "bazel_gazelle")

go_sdk = use_extension("@io_bazel_rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(
    name = "go_sdk",
    version = "1.25.13",
)
use_repo(go_sdk, "go_sdk")

register_toolchains("@go_sdk//:all")

go_deps = use_extension("@bazel_gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(
    go_deps,
    "com_github_golang_protobuf",
    "com_github_grpc_ecosystem_grpc_gateway_v2",
    "com_google_cloud_go_spanner",
    "in_gopkg_yaml_v3",
    "org_golang_google_genproto",
    "org_golang_google_genproto_googleapis_api",
    "org_golang_google_genproto_googleapis_rpc",
    "org_golang_google_grpc",
    "org_golang_google_protobuf",
    "org_golang_x_net",
    "org_golang_x_sys",
    "org_golang_x_text",
)

go_deps.gazelle_override(
    directives = [
        "gazelle:proto disable_global",
    ],
    path = "google.golang.org/grpc",
)
go_deps.gazelle_override(
    directives = [
        "gazelle:proto disable_global",
    ],
    path = "google.golang.org/genproto",
)
go_deps.gazelle_override(
    directives = [
        "gazelle:proto disable_global",
    ],
    path = "google.golang.org/protobuf",
)
go_deps.gazelle_override(
    directives = [
        "gazelle:proto disable_global",
    ],
    path = "github.com/golang/protobuf",
)
go_deps.gazelle_override(
    directives = [
        "gazelle:proto disable_global",
    ],
    path = "gopkg.in/yaml.v3",
)
go_deps.gazelle_override(
    directives = [
        "gazelle:proto disable_global",
    ],
    path = "github.com/grpc-ecosystem/grpc-gateway/v2",
)
go_deps.gazelle_override(
    directives = [
        "gazelle:proto disable_global",
    ],
    path = "golang.org/x/net",
)
go_deps.gazelle_override(
    directives = [
        "gazelle:proto disable_global",
    ],
    path = "golang.org/x/sys",
)
go_deps.gazelle_override(
    directives = [
        "gazelle:proto disable_global",
    ],
    path = "golang.org/x/text",
)

################################################################################
# C++ Libraries                                                                #
################################################################################

bazel_dep(name = "re2", version = "2025.11.5", repo_name = "com_googlesource_code_re2")
archive_override(
    module_name = "re2",
    integrity = "sha256-h/YCnS9t6KoCNlQkCgOtqQ6HbOmkZ24ljdAepMJv/Wc=",
    strip_prefix = "re2-2025-11-05",
    urls = ["https://github.com/google/re2/archive/refs/tags/2025-11-05.tar.gz"],
)

bazel_dep(name = "cpp-httplib", version = "0.22.0")
bazel_dep(name = "riegeli", version = "0.0.0-20250822-9f2744d", repo_name = "com_googlesource_code_riegeli")
bazel_dep(name = "protobuf", version = "33.4", repo_name = "com_google_protobuf")
bazel_dep(name = "abseil-cpp", version = "20260107.1", repo_name = "com_google_absl")
bazel_dep(name = "googletest", version = "1.17.0.bcr.2", repo_name = "com_google_googletest")
bazel_dep(name = "google_cloud_cpp", version = "3.1.0", repo_name = "com_github_googleapis_google_cloud_cpp")
bazel_dep(name = "grpc", version = "1.76.0", repo_name = "com_github_grpc_grpc")
single_version_override(
    module_name = "grpc",
    # Patches applied:
    # - Adding implicit conversion between grpc::Status and absl::Status
    # - Add missing include for std::any_of
    patch_strip = 1,
    patches = ["//build/bazel:grpc.patch"],
    version = "1.76.0",
)

bazel_dep(name = "nlohmann_json", version = "3.12.0.bcr.1", repo_name = "json")

# Pinning to 3.12.bcr.1
single_version_override(
    module_name = "nlohmann_json",
    version = "3.12.0.bcr.1",
)

http_archive(
    name = "com_google_farmhash",
    build_file = "//build/bazel:farmhash.BUILD",
    sha256 = "6560547c63e4af82b0f202cb710ceabb3f21347a4b996db565a411da5b17aba0",
    strip_prefix = "farmhash-816a4ae622e964763ca0862d9dbd19324a1eaf45",
    url = "https://github.com/google/farmhash/archive/816a4ae622e964763ca0862d9dbd19324a1eaf45.tar.gz",
)

bazel_dep(name = "google_benchmark", version = "1.8.3", repo_name = "com_github_google_benchmark")
bazel_dep(name = "googlesql", version = "2026.7.2", repo_name = "com_google_googlesql")
archive_override(
    module_name = "googlesql",
    # Patches applied:
    # - Give visibility to GoogleSQL's base library to reuse some utilities
    integrity = "sha256-9zT65nfWcsYaJ41WJHO/iuLQF/R9TdKzf6Jh5RNoUng=",
    patch_strip = 1,
    patches = ["//build/bazel:googlesql.patch"],
    strip_prefix = "googlesql-2026.7.2",
    urls = ["https://github.com/google/googlesql/archive/refs/tags/2026.7.2.zip"],
)

################################################################################
# Python Libraries                                                             #
################################################################################

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.11",
)
use_repo(python, "python_3_11")

register_toolchains("@python_3_11//:all")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pypi_cloud_spanner_emulator",
    python_version = "3.11",
    requirements_lock = "//:requirements.txt",
)
use_repo(pip, "pypi_cloud_spanner_emulator")

