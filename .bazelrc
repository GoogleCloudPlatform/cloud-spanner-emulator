# =============================================================================
# 1. STANDARDS & TOOLING
# =============================================================================
build --cxxopt=-std=c++20
build --host_cxxopt=-std=c++20
build --conlyopt=-std=gnu11

# Keep dependencies that still use native C++ and proto rules working on Bazel 9.
build --incompatible_autoload_externally=+cc_binary,+cc_library,+cc_test,+cc_proto_library,+java_proto_library,+proto_library

# Ensure Bazel uses the correct system paths for the compiler
build --action_env=CC
build --action_env=CXX
build --action_env=CGO_CPPFLAGS="-std=c++20"

# Python configuration for modern Bazel toolchains
build --python_version=PY3
build --incompatible_use_python_toolchains=false
build --action_env=PYTHON_BIN=/usr/bin/python3

# =============================================================================
# 2. COMPILER COMPATIBILITY (GCC 11+ FIXES)
# =============================================================================
# Force-Include headers often missing in modern gRPC/GoogleSQL prunings
build --cxxopt=-include --cxxopt=limits
build --cxxopt=-include --cxxopt=string
build --cxxopt=-include --cxxopt=cstdint

# Macros to expose C99/C++11 features in strict system libraries
build --cxxopt=-D_GNU_SOURCE
build --copt=-D_GNU_SOURCE
build --cxxopt=-D_GLIBCXX_USE_C99=1
build --cxxopt=-D_GLIBCXX_USE_CXX11_ABI=1

# =============================================================================
# 3. PERFORMANCE & RESOURCE MANAGEMENT
# =============================================================================
# Define the order of preference for spawn strategies.
build --spawn_strategy=local,worker,standalone

# Set resource limits for Docker builds.
build --jobs=auto  # Let Bazel decide parallelism based on budget
build --local_resources=memory=HOST_RAM*0.7  # Leave 30% for the OS/Docker overhead
build --local_resources=cpu=HOST_CPUS

# Use workers for compiler heavy tasks.
build --strategy=ProtoCompile=worker,local,standalone
build --strategy=Javac=worker,local,standalone
build --strategy=CppCompile=local,standalone
build --worker_max_instances=4  # Even if you have 16 CPUs, limit persistent workers to 4
build --worker_quit_after_build  # Clean up for Docker layers
build --experimental_worker_memory_limit_mb=512

# Use pre-built ProtoC from Ubuntu repositories to speed up Docker builds
build --action_env=PROTOC=/usr/bin/protoc
build --proto_compiler=@com_google_protobuf//:protoc
build --incompatible_enable_proto_toolchain_resolution=false

# =============================================================================
# 4. WARNINGS & STRICTNESS (LEGACY/GOOGLESQL SUPPRESSION)
# =============================================================================
build --cxxopt=-fpermissive
build --copt=-DNDEBUG

# Suppress warnings that trigger massive logs in GoogleSQL/Postgres code
build --copt=-Wno-all
build --copt=-Wno-sign-compare
build --copt=-Wno-deprecated-declarations
build --copt=-Wno-return-type
build --copt=-Wno-unused-but-set-parameter

# =============================================================================
# 5. TEST SETTINGS
# =============================================================================
test --test_env=GCLOUD_DIR

# Inform GoogleTest and gMock that Abseil libraries are available
build --define=absl=1
build --cxxopt=-DGTEST_HAS_ABSL=1
